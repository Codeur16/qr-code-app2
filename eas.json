{
  "cli": {
    "version": ">= 0.52.0"
  },
  "build": {
    "production": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:bundleRelease"
      }
    },
    "development": {
      "android": {
        "developmentClient": true
      }
    },
    "customBuild": {
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug",
        "withoutCredentials": true
      }
    },
    "staging": {
      "android": {
        "buildType": "apk",
        "env": {
          "APP_ENV": "staging"
        }
      }
    }
  },
  "submit": {
    "production": {
      "android": {}
    }
  }
}
